# ============================================================
#  API 密钥示例文件
#  用法：复制为 .env 并填入真实值（.env 已被 .gitignore 忽略）
#      cp .env.example .env
# ============================================================

# DeepSeek（推荐，本项目默认）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Kimi / 月之暗面（可选）
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# HuggingFace 镜像（国内加速，下载嵌入模型用）
# HF_ENDPOINT=https://hf-mirror.com
